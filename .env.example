# Copied into the Docker image's build args (see Dockerfile) — Vite bakes VITE_* vars into the
# static bundle at build time, so these have no effect if only set on the running container.
# Left unset, the app falls back to local-dev defaults (relative /api/v1 via the Vite proxy,
# and the hardcoded Keycloak dev URL in src/services/keycloak.ts).

# e.g. http://<server-host>:8580
VITE_API_BASE_URL=

# e.g. http://<server-host>:8189
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=petrotrade
VITE_KEYCLOAK_CLIENT_ID=coupon-backend
